PORT=8080
DATA_DIR=/data
# Public URL of this service (used to build confirm links)
BASE_URL=https://mailbag-api.steinerandco.space
ADMIN_API_KEY=change-me-long-random
# Dashboard origins allowed to call /admin/* (comma-separated). Empty = proxy/same-origin only.
ADMIN_ORIGINS=https://mailbag.steinerandco.space
# Baked into the dashboard JS at build time (Dokploy build var).
VITE_MAILBAG_URL=https://mailbag-api.steinerandco.space

# Default sender (SMTP). Per-list sender_email overrides From.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@yourdomain.com

# Optional: Plunk for SaaS lists (per-list provider=plunk)
PLUNK_API_KEY=

# Turso (recommended). When set, SQLite file/volume is unused.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
